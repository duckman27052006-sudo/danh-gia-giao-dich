# App secrets
ENVIRONMENT=development
# PostgreSQL là mặc định. Cluster local do scripts/dev-db.ps1 quản lý (cổng 5433).
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5433/fraudlens
# Muốn dùng SQLite cho nhanh thì đổi thành:
# DATABASE_URL=sqlite:///./data/fraudlens.db
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_START=true
DEMO_MODE=true
COOKIE_SECURE=false

# AI provider (để trống key = dùng template offline)
AI_ENABLED=true
AI_PROVIDER=auto          # auto | openrouter | openai | anthropic | offline
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
AI_BASE_URL=              # bỏ trống = mặc định theo provider

# OpenRouter — một key dùng được nhiều model (openai/gpt-4o-mini, deepseek/deepseek-chat, ...)
OPENROUTER_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1

# OpenAI trực tiếp
OPENAI_API_KEY=

# Anthropic trực tiếp
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
