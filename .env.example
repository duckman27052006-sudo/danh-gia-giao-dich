# App secrets
ENVIRONMENT=development
# PostgreSQL là database duy nhất của hệ thống. Dev mặc định dùng bản cài trên Windows
# (cổng 5432); production dùng DATABASE_URL của nhà cung cấp.
DATABASE_URL=postgresql+psycopg://fraudlens:fraudlens_dev_password@127.0.0.1:5432/fraudlens
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_START=true
DEMO_MODE=true
# Chỉ cần đặt true nếu CỐ Ý chạy bản demo công khai trên production (tài khoản
# demo có mật khẩu công khai). Mặc định production từ chối khởi động khi
# DEMO_MODE=true mà thiếu biến này.
# ALLOW_DEMO_IN_PRODUCTION=true
COOKIE_SECURE=false

# --- Bảo mật / vận hành (production) ---
# Bắt buộc COOKIE_SECURE=true và JWT_SECRET >= 32 ký tự khi ENVIRONMENT=production.
# ALLOWED_HOSTS=fraudlens.example.com
# TRUST_PROXY_HEADERS=true        # bật khi chạy sau Nginx/Render/Railway
# DOCS_ENABLED=false             # mặc định đã tắt ở production
# EXPLAIN_COOLDOWN_SECONDS=20    # chống spam tạo lại giải thích AI
# MAX_BODY_BYTES=1000000

# AI provider (để trống key = dùng template offline)
AI_ENABLED=true
AI_PROVIDER=auto          # auto | openrouter | openai | anthropic | offline
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
AI_BASE_URL=              # bỏ trống = mặc định theo provider

# OpenRouter — một key dùng được nhiều model (openai/gpt-4o-mini, deepseek/deepseek-chat, ...)
OPENROUTER_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
#
# Chỉ dùng model MIỄN PHÍ (id kết thúc bằng ":free" hoặc router "openrouter/free"):
# AI_MODEL=openrouter/free
# AI_FALLBACK_MODELS=baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3-ultra-550b-a55b:free
# AI_TIMEOUT_SECONDS=75

# OpenAI trực tiếp
OPENAI_API_KEY=

# Anthropic trực tiếp
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
